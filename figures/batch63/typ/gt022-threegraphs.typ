#set page(width: auto, height: auto, margin: 2pt)
#import "@preview/cetz:0.4.2": canvas, draw
#show math.equation: set text(font: "Times New Roman", weight: "bold")
#set text(size: 8pt, font: "Times New Roman", weight: "bold")

#canvas({
  import draw: *
  let px = (x, y) => (x / 148, (309 - y) / 148)
  let t = (thickness: 0.65pt)
  let dot(p) = circle(p, radius: 0.054, fill: black, stroke: none)

  // panel 1: cube Q3 as square-in-square
  let A = px(58, 59)
  let B = px(274, 59)
  let C = px(274, 274)
  let D = px(58, 274)
  let E = px(130, 130)
  let F = px(202, 130)
  let G = px(202, 202)
  let H = px(130, 202)
  line(A, B, stroke: t)
  line(B, C, stroke: t)
  line(C, D, stroke: t)
  line(D, A, stroke: t)
  line(E, F, stroke: t)
  line(F, G, stroke: t)
  line(G, H, stroke: t)
  line(H, E, stroke: t)
  line(A, E, stroke: t)
  line(B, F, stroke: t)
  line(C, G, stroke: t)
  line(D, H, stroke: t)

  // panel 2: K_{4,4}
  let u1 = px(417, 59)
  let u2 = px(417, 130)
  let u3 = px(417, 202)
  let u4 = px(417, 274)
  let v1 = px(561, 59)
  let v2 = px(561, 130)
  let v3 = px(561, 202)
  let v4 = px(561, 274)
  let us = (u1, u2, u3, u4)
  let vs = (v1, v2, v3, v4)
  for uu in us {
    for vv in vs {
      line(uu, vv, stroke: t)
    }
  }

  // panel 3: Mobius ladder on 8 vertices
  let m1 = px(771, 67)
  let m2 = px(853, 67)
  let m3 = px(912, 125)
  let m4 = px(912, 207)
  let m5 = px(853, 266)
  let m6 = px(771, 266)
  let m7 = px(713, 207)
  let m8 = px(713, 125)
  line(m1, m2, stroke: t)
  line(m2, m3, stroke: t)
  line(m3, m4, stroke: t)
  line(m4, m5, stroke: t)
  line(m5, m6, stroke: t)
  line(m6, m7, stroke: t)
  line(m7, m8, stroke: t)
  line(m8, m1, stroke: t)
  line(m8, m4, stroke: t)
  line(m7, m3, stroke: t)
  line(m1, m5, stroke: t)
  line(m6, m2, stroke: t)

  dot(A)
  dot(B)
  dot(C)
  dot(D)
  dot(E)
  dot(F)
  dot(G)
  dot(H)
  dot(u1)
  dot(u2)
  dot(u3)
  dot(u4)
  dot(v1)
  dot(v2)
  dot(v3)
  dot(v4)
  dot(m1)
  dot(m2)
  dot(m3)
  dot(m4)
  dot(m5)
  dot(m6)
  dot(m7)
  dot(m8)

  // panel 1 labels (ink centers measured from source)
  content(px(34.5, 40.5), [$u_1$])
  content(px(294.5, 40.9), [$v_3$])
  content(px(131.0, 105.0), [$v_4$])
  content(px(198.5, 108.5), [$u_2$])
  content(px(135.2, 234.6), [$u_3$])
  content(px(200.8, 233.2), [$v_1$])
  content(px(38.0, 296.1), [$v_2$])
  content(px(292.3, 297.1), [$u_4$])

  // panel 2 labels
  content(px(405, 61.7), anchor: "east", [$u_1$])
  content(px(405, 133.8), anchor: "east", [$u_2$])
  content(px(405, 204.9), anchor: "east", [$u_3$])
  content(px(405, 277.3), anchor: "east", [$u_4$])
  content(px(572, 61.2), anchor: "west", [$v_1$])
  content(px(572, 133.5), anchor: "west", [$v_2$])
  content(px(572, 204.5), anchor: "west", [$v_3$])
  content(px(572, 277.0), anchor: "west", [$v_4$])
})
