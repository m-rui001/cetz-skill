#set page(width: auto, height: auto, margin: 6pt)
#set text(font: ("Arial", "Segoe UI"), size: 10pt)
#import "@preview/cetz:0.4.2": canvas, draw

// 成品：actor/critic 网络结构四联图。(a) 确定性策略：Q 值 critic 拼接 o_t/a_t 两路，actor 输出 μ；
// (b) 随机策略：V 值 critic 单路，actor 输出 π̄ 与 σ 再合成 π；(c)(d) 在 Dense 之后插入 LSTM 128/64
// 单元，其余层序同 (a)(b)。每个 Dense 下方挂 ReLU/SoftPlus/tanh 小标签，粗横线为特征拼接。
// 来源：Robotics 2025, 14, 74, Figure 4 "The neural network architecture for actor and critic".
// DOI 10.3390/robotics14060074

#canvas({
  import draw: *
  let ink = black
  let blu = rgb("#a9c7dc")
  let lstmc = rgb("#8ea7cb")
  let lav = rgb("#cbb8da")
  let peach = rgb("#f8c9a4")
  let grn = rgb("#b7d99b")
  let ar = (end: "stealth", fill: ink, scale: 0.55)

  let inp(x, ytop, body) = {
    rect((x - 0.34, ytop - 0.50), (x + 0.34, ytop), radius: 0.08, fill: peach, stroke: 0.9pt + ink)
    content((x, ytop - 0.25), text(size: 7.5pt, body))
  }
  let dense(x, ytop, n) = {
    rect((x - 0.46, ytop - 0.50), (x + 0.46, ytop), radius: 0.08, fill: blu, stroke: 0.9pt + ink)
    content((x, ytop - 0.15), text(size: 6.5pt, [Dense]))
    content((x, ytop - 0.35), text(size: 5pt, [#n units]))
  }
  let lstm(x, ytop, n) = {
    rect((x - 0.46, ytop - 0.50), (x + 0.46, ytop), radius: 0.08, fill: lstmc, stroke: 0.9pt + ink)
    content((x, ytop - 0.15), text(size: 6.5pt, [LSTM]))
    content((x, ytop - 0.35), text(size: 5pt, [#n units]))
  }
  let tab(x, ytop, body, w: 0.34) = {
    rect((x - w, ytop + 0.06), (x + w, ytop - 0.28), radius: 0.07, fill: lav,
      stroke: (paint: ink, thickness: 0.7pt, dash: "dashed"))
    content((x, ytop - 0.11), text(size: 5pt, body))
  }
  let outp(x, ytop, body, w: 0.44) = {
    rect((x - w, ytop - 0.50), (x + w, ytop), radius: 0.08, fill: grn, stroke: 0.9pt + ink)
    content((x, ytop - 0.25), text(size: 7.5pt, body))
  }
  let arr(x, y1, y2) = line((x, y1), (x, y2), stroke: (paint: ink, thickness: 0.8pt), mark: ar)
  let cat(x1, x2, y) = line((x1, y), (x2, y), stroke: 3.2pt + ink)

  // ===== (a) 确定性策略网络 =====
  inp(0.90, 8.58, [$o_t$])
  inp(1.90, 8.58, [$a_t$])
  inp(3.20, 8.58, [$o_t$])
  arr(0.90, 8.08, 7.85)
  dense(0.90, 7.85, 128)
  tab(0.90, 7.35, [ReLU])
  arr(0.90, 7.07, 6.90)
  dense(0.90, 6.90, 64)
  arr(0.90, 6.40, 6.12)
  arr(1.90, 8.08, 7.32)
  dense(1.90, 7.32, 64)
  arr(1.90, 6.82, 6.12)
  cat(0.40, 2.40, 6.12)
  arr(1.55, 6.12, 5.94)
  tab(1.55, 5.94, [ReLU])
  arr(1.55, 5.66, 5.40)
  dense(1.55, 5.40, 64)
  tab(1.55, 4.90, [ReLU])
  arr(1.55, 4.62, 4.28)
  outp(1.55, 4.28, [$Q(a_t, o_t)$], w: 0.60)
  // actor
  arr(3.20, 8.08, 7.85)
  dense(3.20, 7.85, 128)
  tab(3.20, 7.35, [ReLU])
  arr(3.20, 7.07, 6.90)
  dense(3.20, 6.90, 64)
  tab(3.20, 6.40, [ReLU])
  arr(3.20, 6.12, 5.95)
  dense(3.20, 5.95, 64)
  tab(3.20, 5.45, [ReLU])
  arr(3.20, 5.17, 5.00)
  dense(3.20, 5.00, 2)
  tab(3.20, 4.50, [tanh])
  arr(3.20, 4.22, 3.95)
  outp(3.20, 3.95, [$mu(o_t)$], w: 0.42)

  // ===== (b) 随机策略网络 =====
  inp(4.45, 8.58, [$o_t$])
  arr(4.45, 8.08, 7.85)
  dense(4.45, 7.85, 128)
  tab(4.45, 7.35, [ReLU])
  arr(4.45, 7.07, 6.90)
  dense(4.45, 6.90, 64)
  tab(4.45, 6.40, [ReLU])
  arr(4.45, 6.12, 5.95)
  dense(4.45, 5.95, 64)
  tab(4.45, 5.45, [ReLU])
  arr(4.45, 5.17, 4.82)
  outp(4.45, 4.82, [$V(o_t)$], w: 0.42)
  // actor
  inp(5.85, 8.58, [$o_t$])
  arr(5.85, 8.08, 7.85)
  dense(5.85, 7.85, 128)
  tab(5.85, 7.35, [ReLU])
  arr(5.85, 7.07, 6.90)
  dense(5.85, 6.90, 64)
  tab(5.85, 6.40, [ReLU])
  arr(5.85, 6.12, 5.92)
  cat(5.10, 6.60, 5.92)
  arr(5.40, 5.92, 5.70)
  dense(5.40, 5.70, 64)
  tab(5.40, 5.20, [ReLU], w: 0.36)
  arr(5.40, 4.92, 4.60)
  outp(5.40, 4.60, [$bar(pi)(o_t)$], w: 0.44)
  arr(6.30, 5.92, 5.70)
  dense(6.30, 5.70, 2)
  tab(6.30, 5.20, [SoftPlus], w: 0.36)
  arr(6.30, 4.92, 4.60)
  outp(6.30, 4.60, [$sigma(o_t)$], w: 0.42)
  cat(5.10, 6.60, 3.95)
  arr(5.85, 3.95, 3.72)
  outp(5.85, 3.72, [$pi(o_t)$], w: 0.42)

  // ===== (c) 循环确定性策略网络 =====
  inp(7.25, 8.58, [$o_t$])
  inp(8.25, 8.58, [$a_t$])
  inp(9.40, 8.58, [$o_t$])
  arr(7.25, 8.08, 7.85)
  dense(7.25, 7.85, 128)
  tab(7.25, 7.35, [ReLU])
  arr(7.25, 7.07, 6.90)
  lstm(7.25, 6.90, 128)
  arr(7.25, 6.40, 5.98)
  dense(7.25, 5.98, 64)
  arr(7.25, 5.48, 5.10)
  arr(8.25, 8.08, 7.85)
  dense(8.25, 7.85, 128)
  tab(8.25, 7.35, [ReLU])
  arr(8.25, 7.07, 6.90)
  lstm(8.25, 6.90, 64)
  arr(8.25, 6.40, 5.10)
  cat(6.90, 8.60, 5.10)
  arr(7.75, 5.10, 4.92)
  tab(7.75, 4.92, [ReLU])
  arr(7.75, 4.64, 4.40)
  dense(7.75, 4.40, 64)
  tab(7.75, 3.90, [ReLU])
  arr(7.75, 3.62, 3.25)
  outp(7.75, 3.25, [$Q(a_t, o_t)$], w: 0.60)
  // actor
  arr(9.40, 8.08, 7.85)
  dense(9.40, 7.85, 128)
  tab(9.40, 7.35, [ReLU])
  arr(9.40, 7.07, 6.90)
  lstm(9.40, 6.90, 128)
  arr(9.40, 6.40, 5.98)
  dense(9.40, 5.98, 64)
  tab(9.40, 5.48, [ReLU])
  arr(9.40, 5.20, 5.03)
  dense(9.40, 5.03, 2)
  tab(9.40, 4.53, [tanh])
  arr(9.40, 4.25, 3.98)
  outp(9.40, 3.98, [$mu(o_t)$], w: 0.42)

  // ===== (d) 循环随机策略网络 =====
  inp(10.70, 8.58, [$o_t$])
  arr(10.70, 8.08, 7.85)
  dense(10.70, 7.85, 128)
  tab(10.70, 7.35, [ReLU])
  arr(10.70, 7.07, 6.90)
  lstm(10.70, 6.90, 128)
  arr(10.70, 6.40, 5.98)
  dense(10.70, 5.98, 64)
  tab(10.70, 5.48, [ReLU])
  arr(10.70, 5.20, 5.03)
  dense(10.70, 5.03, 64)
  tab(10.70, 4.53, [ReLU])
  arr(10.70, 4.25, 3.90)
  outp(10.70, 3.90, [$V(o_t)$], w: 0.42)
  // actor
  inp(12.05, 8.58, [$o_t$])
  arr(12.05, 8.08, 7.85)
  dense(12.05, 7.85, 128)
  tab(12.05, 7.35, [ReLU])
  arr(12.05, 7.07, 6.90)
  lstm(12.05, 6.90, 128)
  arr(12.05, 6.40, 5.98)
  dense(12.05, 5.98, 64)
  tab(12.05, 5.48, [ReLU])
  arr(12.05, 5.20, 5.02)
  cat(11.30, 12.80, 5.02)
  arr(11.60, 5.02, 4.80)
  dense(11.60, 4.80, 64)
  tab(11.60, 4.30, [ReLU], w: 0.36)
  arr(11.60, 4.02, 3.70)
  outp(11.60, 3.70, [$bar(pi)(o_t)$], w: 0.44)
  arr(12.50, 5.02, 4.80)
  dense(12.50, 4.80, 2)
  tab(12.50, 4.30, [SoftPlus], w: 0.36)
  arr(12.50, 4.02, 3.70)
  outp(12.50, 3.70, [$sigma(o_t)$], w: 0.42)
  cat(11.30, 12.80, 3.15)
  arr(12.05, 3.15, 2.92)
  outp(12.05, 2.92, [$pi(o_t)$], w: 0.42)

  // ===== 分栏虚线与子图说明 =====
  for x in (3.85, 6.90, 9.95) {
    line((x, 2.55), (x, 8.78), stroke: (paint: rgb("#8a8a8a"), thickness: 0.7pt, dash: "dashed"))
  }
  content((2.00, 2.28), text(size: 7.5pt, [(a) Deterministic policy]))
  content((2.00, 2.03), text(size: 7.5pt, [network.]))
  content((5.40, 2.28), text(size: 7.5pt, [(b) Stochastic policy]))
  content((5.40, 2.03), text(size: 7.5pt, [network.]))
  content((8.45, 2.28), text(size: 7.5pt, [(c) Recurrent]))
  content((8.45, 2.03), text(size: 7.5pt, [deterministic policy]))
  content((8.45, 1.78), text(size: 7.5pt, [network.]))
  content((11.80, 2.28), text(size: 7.5pt, [(d) Recurrent stochastic]))
  content((11.80, 2.03), text(size: 7.5pt, [policy network.]))
})
