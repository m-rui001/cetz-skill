            (462,225),(465,247),(467,270),(467,290),(465,310),(461,330),(455,348),(447,365),
            (437,378),(425,390),(410,401),(390,413),(370,422),(350,429),(325,432),(300,431),
            (275,427),(250,418),(225,405),(200,383),(185,365),(175,349),(170,337),(165,320),
            (168,305),(175,292),(183,281),(190,272),(193,267),(188,262),(180,257),(170,251),
            (160,248),(145,245),(125,241),(100,234),(75,221),(50,205),(25,171))

  // shaded bean U
  let bb = ((368,118),(375,110),(385,98),(400,88),(415,79),(430,75),(450,73),(470,76),
            (490,81),(505,90),(516,100),(524,112),(528,122),(524,133),(514,145),(502,158),
            (490,172),(476,186),(460,198),(445,206),(428,211),(410,210),(393,203),(379,193),
            (368,178),(361,160),(358,142),(361,127))

  // wavy arc from the interior dot out to z
  let wv = ((489,110),(500,97),(510,90),(520,86),(532,83),(545,84),(557,88),(568,95),
            (578,105),(588,117),(598,128),(610,135),(625,139),(640,139),(655,136),(670,131),
            (685,125),(700,120),(715,116),(732,113),(748,112),(762,113),(775,117),(788,123))

  line(path: true, cycle: true, ..P(bb), fill: rgb(180,180,180), stroke: none)
  line(path: true, cycle: true, ..P(bb), stroke: t)
  line(path: true, cycle: true, ..P(lp), stroke: t)
  line(path: true, ..P(wv), stroke: t)

  circle(px(435, 138), radius: 10.5 / S, fill: black, stroke: none)
  circle(px(489, 110), radius: 10.5 / S, fill: black, stroke: none)
  circle(px(789, 122), radius: 8.5 / S, fill: black, stroke: none)

  content(px(29, 70.5), anchor: "center", [$X$])
  content(px(452, 50), anchor: "center", [$U$])
  content(px(416, 140.5), anchor: "center", [$x$])
  content(px(791.5, 127), anchor: "center", [$z$])
