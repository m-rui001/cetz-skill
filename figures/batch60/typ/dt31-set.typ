  let t = (thickness: 1.15pt)

  // big closed curve X, with the small inward fold at lower left
  let lp = ((18,146),(25,120),(50,85),(75,64),(100,49),(125,39),(150,31),(175,25),
            (200,22),(225,20),(250,21),(275,22),(300,27),(325,33),(350,43),(375,57),
