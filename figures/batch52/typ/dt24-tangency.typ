#set page(width: auto, height: auto, margin: 2pt)
#import "@preview/cetz:0.4.2": canvas, draw

#canvas({
  import draw: *
  let S = 148.0
  let px = (x, y) => ((x - 486.0) / S, (220.5 - y) / S)
  let P = (pts) => pts.map(p => px(p.at(0), p.at(1)))
  let t = (thickness: 1.2pt)
  let dd = (thickness: 1.15pt, dash: (6.7pt, 2.3pt))
  let hd = (symbol: ">", fill: black, length: 8.8pt, width: 3.1pt)

  let larc = ((271,22),(266.5,26),(256.5,40),(247.5,55),(240,70),(234,85),(228.5,100),(224,115),
              (220,130),(216.5,145),(214.5,160),(212.5,175),(210.5,190),(208,205),(207,215),
              (208,226),(209.5,236),(210.5,250),(212,265),(214,280),(216.5,295),(220,310),
              (223.5,325),(228.5,340),(233.5,355),(240,370),(247.5,385),(256.5,400),(266.5,414),(271,419))

  let lc = ((17,137),(32,135),(48,136.5),(64,139),(80,141.5),(96,145),(112,149),(128,153.5),
            (144,159),(160,166),(176,174.5),(190,185),(199,194),(205,207),(207,215),(205,224),
            (199,237),(190,246),(176,256.5),(160,265),(144,272),(128,277.5),(112,282),(96,286),
            (80,289.5),(64,292.5),(48,294),(32,296.5),(17,298))

  let rarc = ((957,22),(943.5,40),(932,60),(922,80),(915,100),(909.5,120),(904.5,140),(900.5,160),
              (898.5,180),(897,200),(896,220),(897,240),(898,260),(901,280),(904.5,300),(909,320),
              (914.5,340),(922,360),(931,380),(942.5,400),(956.5,419),(957,419))

  let rc = ((688,131),(710,132),(730,133.5),(750,134.5),(770,136.5),(790,139.5),(810,142.5),
            (830,146.5),(850,151.5),(870,158),(890,166),(910,176.5),(925,187.5),(935,198),
            (941,208),(941,222),(935,238.5),(925,249),(910,260),(890,269.5),(870,277.5),
            (850,283.5),(830,288.5),(810,292.5),(790,295.5),(770,298),(750,299.5),(730,301.5),
            (710,302),(705,302))

  let spl = (pts, n: 5) => {
    let k = pts.len()
    let out = ()
    for i in range(0, k - 1) {
      let p0 = if i == 0 { pts.at(0) } else { pts.at(i - 1) }
      let p1 = pts.at(i)
      let p2 = pts.at(i + 1)
      let p3 = if i + 2 >= k { pts.at(k - 1) } else { pts.at(i + 2) }
      for j in range(0, n) {
        let u = j / n
        let w0 = -0.5 * u + u * u - 0.5 * u * u * u
        let w1 = 1.0 - 2.5 * u * u + 1.5 * u * u * u
        let w2 = 0.5 * u + 2.0 * u * u - 1.5 * u * u * u
        let w3 = -0.5 * u * u + 0.5 * u * u * u
        out.push((w0 * p0.at(0) + w1 * p1.at(0) + w2 * p2.at(0) + w3 * p3.at(0),
                  w0 * p0.at(1) + w1 * p1.at(1) + w2 * p2.at(1) + w3 * p3.at(1)))
      }
    }
    out.push(pts.at(k - 1))
    out
  }

  line(path: true, ..P(spl(larc)), stroke: t)
  line(path: true, ..P(spl(lc)), stroke: t)
  line(path: true, ..P(spl(rarc)), stroke: t)
  line(path: true, ..P(spl(rc)), stroke: t)
  line(px(321, 215), px(623, 215), stroke: dd, mark: (end: hd))
})
